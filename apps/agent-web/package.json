{
  "name": "@fastagent/agent-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "api:generate": "openapi-typescript ../../packages/contracts/openapi.json -o src/api/schema.d.ts",
    "api:check": "node scripts/check-api-client.mjs",
    "i18n:extract": "lingui extract --clean",
    "i18n:compile": "lingui compile",
    "i18n:check": "node scripts/check-i18n.mjs"
  },
  "dependencies": {
    "@lingui/core": "^5.7.0",
    "@lingui/react": "^5.7.0",
    "antd": "^5.12.2",
    "openapi-fetch": "^0.14.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.1.0"
  },
  "devDependencies": {
    "@lingui/babel-plugin-lingui-macro": "^5.7.0",
    "@lingui/cli": "^5.7.0",
    "@lingui/vite-plugin": "^5.7.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^25.0.1",
    "openapi-typescript": "^7.5.0",
    "typescript": "^5.2.2",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
