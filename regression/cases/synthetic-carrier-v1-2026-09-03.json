{
  "schema_version": "1.0.0",
  "status": "ACTIVE",
  "profile_release": "synthetic-two-axis-desk",
  "assertions_confirmed_by_user_on": null,
  "source": {
    "system": "synthetic",
    "method": "Authored for this repository. No customer, merchant or production data of any kind was used, so there is nothing here to de-identify and no authorisation context that can lapse -- which is the whole reason ADR-0039 needed a synthetic carrier.",
    "carrier_dimensions": {
      "note": "The two goal frames are classified by three orthogonal dimensions rather than by industry. They are recorded here rather than in the profile because merchant-profile.schema.json pins each frame with additionalProperties:false, and widening a shipped contract to carry a test carrier's taxonomy would be the implementation rewriting the drawing.",
      "rental": {
        "goods_flow": "both_ways",
        "money_flow": "both_ways",
        "pricing": "fixed"
      },
      "consultation": {
        "goods_flow": "none",
        "money_flow": "inbound",
        "pricing": "to_be_assessed"
      }
    }
  },
  "usage_boundary": {
    "allowed": [
      "offline replay",
      "isolated Stage validation"
    ],
    "forbidden": [
      "Production ingress",
      "customer contact",
      "external delivery"
    ]
  },
  "mock_manifest": [
    "channel",
    "clock",
    "model",
    "knowledge",
    "business_event",
    "executor"
  ],
  "invariant_definitions_ref": "regression/invariants.json",
  "vocabulary": {
    "note": "Declared here because the assertion schema no longer pins it. The retired corpus had its frame ids and phases held by `const`/`enum` in the schema; generalising that for a second carrier removed the only thing holding corpus vocabulary, and for a while nothing replaced it (independent review 2026-09-03, P2b). Frame ids are checked against the profile itself; phases and bases are checked against these lists.",
