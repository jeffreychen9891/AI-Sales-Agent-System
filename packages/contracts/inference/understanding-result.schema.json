{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fastagent.invalid/contracts/inference/understanding-result.schema.json",
  "title": "UnderstandingResult",
  "description": "Output of the understanding step. It never selects a strategy, never produces customer-visible text and never calls tools.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "facts",
    "intents",
    "slot_updates",
    "interruption",
    "sentiment",
    "risk_markers",
    "customer_commitments",
    "uncertainties",
    "model_evidence",
    "turn_summary"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "facts": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "typed_value",
          "confidence"
        ],
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "typed_value": {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "intents": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "intent_label",
          "confidence"
        ],
        "properties": {
          "intent_label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "slot_updates": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "frame_id",
          "slot",
          "value",
          "confidence",
          "evidence_event_id"
        ],
        "properties": {
          "frame_id": {
            "type": "string",
            "format": "uuid"
          },
          "slot": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "value": {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ],
            "maxLength": 400,
            "description": "临时值，预算链重推后按新的 MATERIAL_BYTES_BUDGET 重定；依据见 docs/reviews/stage-bucket-capacity-2026-09-15.md"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "evidence_event_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      }
    },
    "interruption": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relation",
        "suggested_frame_definition_id"
      ],
      "properties": {
        "relation": {
          "enum": [
            "same_goal",
            "side_question",
            "new_goal",
            "correction",
            "exit",
            "human_request"
          ]
        },
        "suggested_frame_definition_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        }
      }
    },
    "sentiment": {
      "enum": [
        "positive",
        "neutral",
        "negative",
        "unknown"
      ]
    },
    "risk_markers": {
      "type": "array",
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "enum": [
          "none",
          "complaint",
          "urgency",
          "price_pressure",
          "compliance_request",
          "escalation_request",
          "unverified_identity"
        ]
      }
    },
    "customer_commitments": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "summary",
          "type",
          "due_at",
          "evidence_event_id",
          "confidence"
        ],
        "properties": {
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "type": {
            "enum": [
              "quote_or_calculate",
              "lookup_or_verify",
              "apply_price_or_discount",
              "send_material",
              "contact_or_ask_human",
              "provide_information",
              "take_action"
            ],
            "description": "哪一类（RFC §5）。理由见 worker/commitment_ledger.py。"
          },
          "due_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "evidence_event_id": {
            "type": "string",
            "format": "uuid"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "uncertainties": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "field",
          "reason"
        ],
        "properties": {
          "field": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        }
      }
    },
    "model_evidence": {
      "$ref": "https://fastagent.invalid/contracts/inference/model-evidence.schema.json"
    },
    "turn_summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 480,
      "description": "One line about what the customer said and wants in this message. Only his half: the reply does not exist yet when this is written. Do not quote him verbatim and do not repeat figures he did not say. Do not restate earlier turns -- they are already recorded."
    }
  }
}
